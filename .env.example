# ─── Copy this file to .env and fill in your values ───
# Never commit .env to git

# GitHub
GITHUB_TOKEN=your_github_personal_access_token

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# OpenAI (Entity Resolution Agent)
OPENAI_API_KEY=your_openai_api_key

# Google Gemini (Entity Resolution Agent — alternative)
GEMINI_API_KEY=your_gemini_api_key

# Vector DB (ChromaDB — local, no key needed)
CHROMA_PERSIST_DIR=./data/vectordb

# Knowledge Graph output directory
GRAPH_OUTPUT_DIR=./data/output/graphs

# Confidence threshold
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60
